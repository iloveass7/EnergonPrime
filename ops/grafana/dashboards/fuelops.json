{
 "title": "FuelOps \u2014 Operations (simulated)",
 "uid": "fuelops",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 0,
   "type": "timeseries",
   "title": "API p95 / p50 latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "B"
    }
   ]
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "API request rate by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(http_requests_total[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Simulator latency p95 by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(sim_request_duration_seconds_bucket[1m])))",
     "legendFormat": "{{endpoint}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Simulator errors by kind",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (kind) (rate(sim_errors_total[1m]))",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Circuit state (0 closed, 2 open) / stream connected",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sim_circuit_state",
     "legendFormat": "circuit",
     "refId": "A"
    },
    {
     "expr": "sim_stream_connected",
     "legendFormat": "stream",
     "refId": "B"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Simulator tick / epoch",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sim_tick",
     "legendFormat": "tick",
     "refId": "A"
    },
    {
     "expr": "sim_epoch",
     "legendFormat": "epoch",
     "refId": "B"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Risk keys by level",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "risk_keys",
     "legendFormat": "{{level}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Forecast WAPE by fuel",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "forecast_wape",
     "legendFormat": "{{fuel}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Refresh / planner duration p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, rate(sync_duration_seconds_bucket[1m]))",
     "legendFormat": "refresh",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(planner_duration_seconds_bucket[1m])))",
     "legendFormat": "planner",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Decisions: intents / operator actions",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (state) (increase(intent_state_total[5m]))",
     "legendFormat": "intent {{state}}",
     "refId": "A"
    },
    {
     "expr": "sum by (action) (increase(operator_actions_total[5m]))",
     "legendFormat": "op {{action}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Alerts opened by kind",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (kind) (increase(alerts_opened_total[5m]))",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Fallbacks active",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "fallback_active",
     "legendFormat": "{{component}}",
     "refId": "A"
    }
   ]
  }
 ]
}