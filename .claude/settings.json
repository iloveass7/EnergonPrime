{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": ["superpowers@superpowers-marketplace"],
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(uv run:*)",
      "Bash(ruff:*)",
      "Bash(docker compose:*)",
      "Bash(npm run:*)",
      "Bash(curl http://localhost:*)",
      "mcp__context7",
      "mcp__serena"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  }
}
