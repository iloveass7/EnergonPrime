# Copy to .env (git-ignored) and fill in. Never commit real values. All data is SIMULATED.
APP_ENV=local                      # local | test | demo | public (public forces AUTH_MODE=apikey, disables test plane)
SIM_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# Neon: pooled endpoint for api/worker, direct endpoint for migrations.
# Leave DATABASE_URL unset to run on a local SQLite file (reported as degraded).
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?ssl=require
# DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?ssl=require

ENABLE_SIMULATOR_TEST_CONTROLS=true
AUTH_MODE=off                      # off | apikey
# API_KEY_VIEWER=
# API_KEY_OPERATOR=
# API_KEY_ADMIN=

POLL_INTERVAL_MS=1000
RISK_HORIZON_TICKS=32
MIN_LEG_LITERS=200
DEPOT_RESERVE_FRACTION=0.05
