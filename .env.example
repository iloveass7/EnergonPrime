# Copy to .env (git-ignored) and fill in. Never commit real values.
# Neon: pooled endpoint for api/worker, direct endpoint for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?ssl=require
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?ssl=require
REDIS_URL=redis://redis:6379/0
SIM_BASE_URL=http://simulator-api:8000

# LLM gateway (optional; directives fall back to the structured form when off)
LLM_ENABLED=false
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY_1=
LLM_BACKUP_MODEL=
LLM_BACKUP_API_KEY_1=
